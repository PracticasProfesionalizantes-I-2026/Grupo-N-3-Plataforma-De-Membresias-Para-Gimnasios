tests {
  test("Debe responder con status 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Debe devolver el recepcionista con el Id consultado", function() {
    const data = res.getBody ? res.getBody() : res.body;
    expect(data).to.be.an("object");
    expect(data.id).to.equal(bru.getEnvVar("recepcionistaId"));
  });
}
