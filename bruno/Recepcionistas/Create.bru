script:post-response {
  const data = res.getBody ? res.getBody() : res.body;
  if (res.getStatus() === 201 && data && data.id) {
    bru.setEnvVar("recepcionistaId", data.id);
  }
}

tests {
  test("Debe responder con status 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Debe retornar el recepcionista creado con su Guid generado", function() {
    const data = res.getBody ? res.getBody() : res.body;
    expect(data).to.have.property("id");
    expect(data.nombre).to.equal("Valeria Sanchez");
    expect(data.turno).to.equal("Mañana");
    expect(data.legajo).to.equal("REC-10492");
  });
}
