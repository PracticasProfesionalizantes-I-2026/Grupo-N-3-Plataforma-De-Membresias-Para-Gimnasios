meta {
  name: Delete
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/membresias/{{membresiaId}}
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

tests {
  test("Debe responder con status 200 OK o 204 No Content al eliminar membresía", function() {
    expect([200, 204]).to.include(res.getStatus());
  });
}

