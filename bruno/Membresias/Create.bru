meta {
  name: Create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/membresias
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "socioId": "{{socioId}}",
    "planMembresiaId": "{{planMembresiaId}}",
    "fechaInicio": "2023-01-01"
  }
}


tests {
  test("Debe responder con status 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Debe retornar la membresía creada con su Guid y datos asociados", function() {
    const data = res.getBody ? res.getBody() : res.body;
    expect(data).to.have.property("id");
    expect(data.tipo).to.equal("Gold");
    expect(Number(data.precio)).to.equal(25000);
    expect(data.duracionDias).to.equal(30);
  });
}

script:post-response {
  const data = res.getBody ? res.getBody() : res.body;
  if (res.getStatus() === 201 && data && data.id) {
    bru.setEnvVar("membresiaId", data.id);
  }
}

